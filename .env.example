# FloodGuard Environment Configuration
# Copy to .env and fill in values

# Application
NODE_ENV=development
DEMO_MODE=true
PORT=4000

# AWS (for deployment)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Database
DYNAMODB_TABLE_REPORTS=floodguard-reports
DYNAMODB_TABLE_RISK_ZONES=floodguard-risk-zones
DYNAMODB_TABLE_ALERTS=floodguard-alerts

# Storage
S3_BUCKET_REPORTS=floodguard-report-images
S3_BUCKET_FRONTEND=floodguard-frontend

# Notifications
SNS_TOPIC_ALERTS=

# External APIs (optional)
WEATHER_API_KEY=
WEATHER_API_URL=

# AI (optional)
BEDROCK_MODEL_ID=anthropic.claude-v2
